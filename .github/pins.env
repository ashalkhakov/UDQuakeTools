# The commits UDQuakeTools builds on, in one place: ci.yml and release.yml
# load them (gnustep-release-actions). Each must be a full commit hash: a
# branch or a short hash would move under the build. Move one in a commit of
# its own, so that a red run has one cause.

# ashalkhakov/gnustep-patches: the shared GNUstep fixes and its
# build-gnustep.sh, the stack every app builds on. UDQuakeTools' own gnustep-gui
# fixes (the contentSet binding, NSViewController's nib objects, the table
# view's selectionIndexes push) are all merged upstream.
GNUSTEP_PATCHES_REF=01f38d2f4b26a06a4d90fd2dc824a7f55974180e

# ashalkhakov/FreeCoreData: Core Data for GNUstep (the framework, momc,
# coredata-model.make).
FREECOREDATA_REF=b7604385dd668d921576c3b20c83b878e0edb1b1
