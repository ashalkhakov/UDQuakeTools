<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDVariablesController">
            <connections>
                <outlet property="variablesTableView" destination="TBL-VARS" id="OWN-VARTABLE"/>
                <outlet property="variablesTypeControl" destination="SEG-VAR-TYPE" id="OWN-VARTYPE"/>
                <outlet property="view" destination="PNL-VARS" id="OWN-VIEW"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="YLy-65-1bz" customClass="NSFontManager"/>
        <customView id="PNL-VARS">
            <rect key="frame" x="0.0" y="0.0" width="668" height="632"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <scrollView fixedFrame="YES" autohidesScrollers="YES" horizontalLineScroll="20" horizontalPageScroll="10" verticalLineScroll="20" verticalPageScroll="10" translatesAutoresizingMaskIntoConstraints="NO" id="SCR-VARS">
                    <rect key="frame" x="0.0" y="34" width="668" height="596"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" id="CLP-VARS">
                        <rect key="frame" x="1" y="1" width="666" height="594"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView rowHeight="20" id="TBL-VARS" customClass="UDInspectableTableView">
                                <rect key="frame" x="0.0" y="0.0" width="666" height="594"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <tableColumns>
                                    <tableColumn identifier="name" width="190" minWidth="80" maxWidth="400" id="COL-VAR-NAME">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Name"/>
                                        <textFieldCell key="dataCell" controlSize="small" lineBreakMode="truncatingTail" selectable="YES" editable="YES" alignment="left" title="variable" id="CELL-VAR-NAME">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                    </tableColumn>
                                    <tableColumn identifier="type" width="100" minWidth="72" maxWidth="140" id="COL-VAR-TYPE">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Type"/>
                                        <textFieldCell key="dataCell" controlSize="small" lineBreakMode="truncatingTail" alignment="left" title="float" id="CELL-VAR-TYPE">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                    </tableColumn>
                                    <tableColumn identifier="value" width="345" minWidth="120" maxWidth="1000" id="COL-VAR-VALUE">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Value"/>
                                        <textFieldCell key="dataCell" controlSize="small" lineBreakMode="truncatingTail" selectable="YES" editable="YES" alignment="left" title="0" id="CELL-VAR-VALUE">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                    </tableColumn>
                                </tableColumns>
                                <connections>
                                    <outlet property="dataSource" destination="-2" id="TBL-VARS-DS"/>
                                    <outlet property="delegate" destination="-2" id="TBL-VARS-DEL"/>
                                </connections>
                            </tableView>
                        </subviews>
                    </clipView>
                </scrollView>
                <segmentedControl fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="SEG-VAR-ACTIONS">
                    <rect key="frame" x="0.0" y="470" width="56" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" controlSize="small" style="rounded" trackingMode="momentary" id="SEG-VAR-ACTIONS-CELL">
                        <font key="font" metaFont="smallSystem"/>
                        <segments>
                            <segment label="+" width="28"/>
                            <segment label="-" width="28"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="changeVariablesActionButtons:" target="-2" id="ACT-VAR-ACTIONS"/>
                    </connections>
                </segmentedControl>
                <segmentedControl fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="SEG-VAR-TYPE">
                    <rect key="frame" x="64" y="468" width="180" height="28"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" controlSize="small" style="rounded" trackingMode="selectOne" id="SEG-VAR-TYPE-CELL">
                        <font key="font" metaFont="smallSystem"/>
                        <segments>
                            <segment label="Float" width="88"/>
                            <segment label="Vec4" width="88"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="changeSelectedVariableType:" target="-2" id="ACT-VAR-TYPE"/>
                    </connections>
                </segmentedControl>
            </subviews>
            <point key="canvasLocation" x="140" y="154"/>
        </customView>
    </objects>
</document>
