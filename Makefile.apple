# UDQuakeTools on macOS, the familiar way (gnustep-release-actions' macos.yml
# runs the same):
#
#   make -f Makefile.apple            UDCode's UDQuakeTools extension
#                                     (UDQuakeTools.bundle, universal, Release:
#                                     Quarry and Pak Manager, which
#                                     Scripts/udcx.sh packages)
#   make -f Makefile.apple check      the tests: the libraries' and the
#                                     extension's (Tests/Quarry, Tests/Extension)
#   make -f Makefile.apple install DESTDIR=<dir>       the bundle
#   make -f Makefile.apple installcheck DESTDIR=<dir>  it has its principal
#                                     class, its tools and its libraries, and
#                                     leaves out what UDCode has itself
#
# The libraries need nothing beyond the system's zlib (archives are read by
# the minizip that came with the Doom 3 file system and written by
# UDZipWriter). UDCode's SDK (UDCodeKit, UDPieceTable, LSPKit) is in .deps/,
# by the versions .github/pins.env names (gnustep-release-actions'
# scripts/deps.sh apple); the bundle links it and the running UDCode's is used.

BUILD = build
DERIVED = $(BUILD)/DerivedData
RELEASE = $(DERIVED)/Build/Products/Release
XCODEBUILD = xcodebuild -project PakManager.xcodeproj -derivedDataPath $(DERIVED)
BUNDLE = UDQuakeTools.bundle

all:
	@test -d .deps/UDCodeKit.xcframework \
	  || { echo "no UDCodeKit in .deps: gnustep-release-actions' scripts/deps.sh apple fetches what .github/pins.env names"; exit 1; }
	$(XCODEBUILD) -scheme UDQuakeTools -configuration Release -destination 'generic/platform=macOS' build

# The test bundles are not signed: nothing ships from them.
check:
	$(XCODEBUILD) -scheme Libraries -configuration Debug -destination 'platform=macOS' test CODE_SIGNING_ALLOWED=NO
	$(XCODEBUILD) -scheme QuarryTests -configuration Debug -destination 'platform=macOS' test CODE_SIGNING_ALLOWED=NO

install: all
	@test -n "$(DESTDIR)" || { echo "install: give DESTDIR"; exit 1; }
	mkdir -p $(DESTDIR)
	rm -rf $(DESTDIR)/$(BUNDLE)
	ditto $(RELEASE)/$(BUNDLE) $(DESTDIR)/$(BUNDLE)

installcheck:
	@b=$(DESTDIR)/$(BUNDLE); \
	  test "$$(/usr/libexec/PlistBuddy -c 'Print :NSPrincipalClass' $$b/Contents/Info.plist)" = UQExtension \
	    || { echo "$(BUNDLE): its principal class is not UQExtension"; exit 1; }; \
	  for tool in udscript-lsp udscript-dap; do \
	    test -x $$b/Contents/MacOS/$$tool || { echo "$(BUNDLE) has no $$tool"; exit 1; }; \
	  done; \
	  for fw in UDDecls UDWorkspace LSPServerKit; do \
	    test -d $$b/Contents/Frameworks/$$fw.framework || { echo "$(BUNDLE) does not carry $$fw.framework"; exit 1; }; \
	  done; \
	  for fw in UDCodeKit UDPieceTable LSPKit; do \
	    if test -e $$b/Contents/Frameworks/$$fw.framework; then echo "$(BUNDLE) carries UDCode's own $$fw.framework"; exit 1; fi; \
	  done; \
	  codesign --verify --deep --strict $$b; \
	  echo "$(BUNDLE): UQExtension, its tools and libraries, nothing of UDCode's"

clean:
	rm -rf $(BUILD)

.PHONY: all check install installcheck clean
