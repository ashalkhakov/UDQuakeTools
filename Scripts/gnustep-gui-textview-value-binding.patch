     object: _notifObject];
 
+  theBinding = [GSKeyValueBinding getBinding: NSValueBinding
+                                   forObject: self];
+  if (theBinding != nil)
+    {
+      [theBinding reverseSetValueFor: @"string"];
+    }
+
