<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDAFEditorViewController">
            <connections>
                <outlet property="view" destination="AFE-root" id="UDA-o-view"/>
                <outlet property="objectController" destination="AFE-oc" id="UDA-o-objectController"/>
                <outlet property="tabView" destination="AFE-tabs" id="UDA-o-tabView"/>
                <outlet property="bodiesController" destination="AFE-bac" id="UDA-o-bodiesController"/>
                <outlet property="bodiesTable" destination="AFE-bodies" id="UDA-o-bodiesTable"/>
                <outlet property="constraintsController" destination="AFE-cac" id="UDA-o-constraintsController"/>
                <outlet property="constraintsTable" destination="AFE-constraints" id="UDA-o-constraintsTable"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <objectController objectClassName="UDDeclAF" id="AFE-oc" userLabel="Object Controller">
            <classReference key="objectClass" className="UDDeclAF"/>
        </objectController>
        <arrayController objectClassName="UDAFBody" id="AFE-bac" userLabel="UDAFBody Array Controller">
            <classReference key="objectClass" className="UDAFBody"/>
            <connections>
                <binding destination="AFE-oc" name="contentArray" keyPath="selection.bodies" id="AFE-bac-b"/>
            </connections>
        </arrayController>
        <arrayController objectClassName="UDAFConstraint" id="AFE-cac" userLabel="UDAFConstraint Array Controller">
            <classReference key="objectClass" className="UDAFConstraint"/>
            <connections>
                <binding destination="AFE-oc" name="contentArray" keyPath="selection.constraints" id="AFE-cac-b"/>
            </connections>
        </arrayController>
