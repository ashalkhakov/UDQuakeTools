<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDMaterialEditorViewController">
            <connections>
                <outlet property="view" destination="MTE-root" id="UDM-o-view"/>
                <outlet property="objectController" destination="MTE-oc" id="UDM-o-objectController"/>
                <outlet property="stagesController" destination="MTE-sac" id="UDM-o-stagesController"/>
                <outlet property="stagesTable" destination="MTE-stages" id="UDM-o-stagesTable"/>
                <outlet property="previewView" destination="MTE-preview" id="UDM-o-previewView"/>
                <outlet property="previewLabel" destination="MTE-previewlabel" id="UDM-o-previewLabel"/>
                <outlet property="materialPreviewView" destination="MTE-matpreview" id="UDM-o-materialPreviewView"/>
                <outlet property="lightingLabel" destination="MTE-lighting" id="UDM-o-lightingLabel"/>
                <outlet property="transportView" destination="MTE-transport" id="UDM-o-transportView"/>
                <outlet property="inspectorView" destination="MTE-inspector" id="UDM-o-inspectorView"/>
                <outlet property="inspectorTabs" destination="MTE-itabs" id="UDM-o-inspectorTabs"/>
                <outlet property="materialScroll" destination="MTE-mscroll" id="UDM-o-materialScroll"/>
                <outlet property="stageScroll" destination="MTE-sscroll" id="UDM-o-stageScroll"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <objectController objectClassName="UDDeclMaterial" id="MTE-oc" userLabel="Object Controller">
            <classReference key="objectClass" className="UDDeclMaterial"/>
        </objectController>
        <arrayController avoidsEmptySelection="NO" objectClassName="UDMaterialStage" id="MTE-sac" userLabel="UDMaterialStage Array Controller">
            <classReference key="objectClass" className="UDMaterialStage"/>
            <connections>
                <binding destination="MTE-oc" name="contentArray" keyPath="selection.stages" id="MTE-sac-b"/>
            </connections>
        </arrayController>
        <customView id="MTE-root">
            <rect key="frame" x="0.0" y="0.0" width="900" height="640"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <imageView toolTip="material preview" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-matpreview">
                    <rect key="frame" x="20" y="300" width="320" height="320"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyUpOrDown" imageFrameStyle="grayBezel" id="MTE-matpreview-c"/>
                </imageView>
                <customView toolTip="time controls" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-transport">
                    <rect key="frame" x="20" y="240" width="320" height="56"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                </customView>
                <textField toolTip="lighting problem" focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-lighting">
                    <rect key="frame" x="360" y="540" width="520" height="80"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="charWrapping" title="" id="MTE-lighting-c">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <scrollView fixedFrame="YES" horizontalLineScroll="24" horizontalPageScroll="10" verticalLineScroll="24" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-stages-s">
                    <rect key="frame" x="20" y="37" width="860" height="197"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" id="MTE-stages-cv">
                        <rect key="frame" x="1" y="1" width="858" height="195"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" emptySelection="YES" autosaveColumns="NO" rowHeight="22" headerView="MTE-stages-h" id="MTE-stages">
                                <rect key="frame" x="0.0" y="0.0" width="858" height="167"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <size key="intercellSpacing" width="17" height="0.0"/>
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                <tableColumns>
                                        <tableColumn identifier="stage" editable="NO" width="160" minWidth="30" maxWidth="1000" id="MTE-stages-stage">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Stage">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="NO" title="Text Cell" id="MTE-stages-stage-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                        <tableColumn identifier="blend" editable="NO" width="110" minWidth="30" maxWidth="1000" id="MTE-stages-blend">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Blend">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="NO" title="Text Cell" id="MTE-stages-blend-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                            <connections>
                                                <binding destination="MTE-sac" name="value" keyPath="arrangedObjects.blend" id="MTE-stages-blend-b">
                                                    <dictionary key="options">
                                                        <bool key="NSValidatesImmediately" value="YES"/>
                                                    </dictionary>
                                                </binding>
                                            </connections>
                                        </tableColumn>
                                        <tableColumn identifier="map" editable="NO" width="269" minWidth="30" maxWidth="1000" id="MTE-stages-map">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Map">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="NO" title="Text Cell" id="MTE-stages-map-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                            <connections>
                                                <binding destination="MTE-sac" name="value" keyPath="arrangedObjects.map" id="MTE-stages-map-b">
                                                    <dictionary key="options">
                                                        <bool key="NSValidatesImmediately" value="YES"/>
                                                    </dictionary>
                                                </binding>
                                            </connections>
                                        </tableColumn>
                                </tableColumns>
                                <connections>
                                    <outlet property="dataSource" destination="-2" id="MTE-stages-ds"/>
                                    <outlet property="delegate" destination="-2" id="MTE-stages-dg"/>
                                    <binding destination="MTE-sac" name="content" keyPath="arrangedObjects" id="MTE-stages-bc"/>
                                    <binding destination="MTE-sac" name="selectionIndexes" keyPath="selectionIndexes" previousBinding="MTE-stages-bc" id="MTE-stages-bs"/>
                                </connections>
                            </tableView>
                        </subviews>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="MTE-stages-hs">
                        <rect key="frame" x="1" y="181" width="858" height="15"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="MTE-stages-vs">
                        <rect key="frame" x="844" y="17" width="15" height="102"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <tableHeaderView key="headerView" wantsLayer="YES" id="MTE-stages-h">
                        <rect key="frame" x="0.0" y="0.0" width="858" height="28"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </tableHeaderView>
                </scrollView>
                <segmentedControl verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-stages-pm">
                    <rect key="frame" x="20" y="12" width="69" height="23"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="smallSquare" trackingMode="selectOne" id="MTE-stages-pm-c">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="+" width="32"/>
                            <segment label="-" width="32" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="addOrRemoveStage:" target="-2" id="MTE-stages-pm-a"/>
                    </connections>
                </segmentedControl>
                <segmentedControl toolTip="move stage" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-move">
                    <rect key="frame" x="95" y="12" width="69" height="23"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="smallSquare" trackingMode="momentary" id="MTE-move-c">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="↑" width="32"/>
                            <segment label="↓" width="32" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="moveStage:" target="-2" id="MTE-move-a"/>
                    </connections>
                </segmentedControl>
                <popUpButton toolTip="add lighting stage" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-addlit">
                    <rect key="frame" x="170" y="10" width="120" height="25"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Add Map" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" pullsDown="YES" id="MTE-addlit-c">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="message"/>
                        <menu key="menu" id="MTE-addlit-m">
                            <items>
                                <menuItem title="Add Map" hidden="YES" id="MTE-addlit-i0"/>
                                <menuItem title="Bump Map" tag="1" id="MTE-addlit-i1">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a1"/></connections>
                                </menuItem>
                                <menuItem title="Diffuse Map" tag="2" id="MTE-addlit-i2">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a2"/></connections>
                                </menuItem>
                                <menuItem title="Specular Map" tag="3" id="MTE-addlit-i3">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a3"/></connections>
                                </menuItem>
                            </items>
                        </menu>
                    </popUpButtonCell>
                </popUpButton>

            </subviews>
        </customView>
        <customView id="MTE-inspector" userLabel="Inspector">
            <rect key="frame" x="0.0" y="0.0" width="280" height="600"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <tabView type="noTabsNoBorder" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-itabs">
                    <rect key="frame" x="0.0" y="0.0" width="280" height="600"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <font key="font" metaFont="system"/>
                    <tabViewItems>
                        <tabViewItem label="Material" identifier="material" id="MTE-im">
                            <view key="view" id="MTE-im-v">
                                <rect key="frame" x="0.0" y="0.0" width="280" height="600"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                            <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-mscroll">
                                <rect key="frame" x="0.0" y="0.0" width="280" height="600"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <clipView key="contentView" drawsBackground="NO" id="MTE-mscroll-cv" customClass="UDTopClipView">
                                    <rect key="frame" x="0.0" y="0.0" width="280" height="600"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <subviews>
                                        <view id="MTE-mscroll-doc">
                                            <rect key="frame" x="0.0" y="0.0" width="265" height="861"/>
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                                            <subviews>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-h69">
                                                <rect key="frame" x="8" y="831" width="200" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" lineBreakMode="clipping" title="Material" id="MTE-h69-c">
                                                    <font key="font" metaFont="systemBold"/>
                                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-l71">
                                                <rect key="frame" x="4" y="808" width="88" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Description:" id="MTE-l71-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField toolTip="description &quot;text&quot;: what the material is, as the editors show it; the game does not use it." focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-f70">
                                                <rect key="frame" x="96" y="805" width="160" height="21"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="MTE-f70-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <connections>
                                                    <binding destination="MTE-oc" name="value" keyPath="selection.materialDescription" id="MTE-f70-b">
                                                        <dictionary key="options">
                                                            <bool key="NSValidatesImmediately" value="YES"/>
                                                        </dictionary>
                                                    </binding>
                                                </connections>
                                            </textField>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-l73">
                                                <rect key="frame" x="4" y="783" width="88" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Editor Image:" id="MTE-l73-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField toolTip="qer_editorimage: the image the level editor shows for the material in its texture browser." focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-f72">
                                                <rect key="frame" x="96" y="780" width="160" height="21"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="MTE-f72-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <connections>
                                                    <binding destination="MTE-oc" name="value" keyPath="selection.qerEditorImage" id="MTE-f72-b">
                                                        <dictionary key="options">
                                                            <bool key="NSValidatesImmediately" value="YES"/>
                                                        </dictionary>
                                                    </binding>
                                                </connections>
                                            </textField>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-l75">
                                                <rect key="frame" x="4" y="758" width="88" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Surface Type:" id="MTE-l75-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <popUpButton toolTip="The surface's type (metal, stone, flesh, wood, …): which footsteps, impacts and decals the game gives it." verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-p74">
                                                <rect key="frame" x="96" y="752" width="160" height="25"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                                <popUpButtonCell key="cell" type="push" title="(none)" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="MTE-p74-i0" id="MTE-p74-c">
                                                    <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="message"/>
                                                    <menu key="menu" id="MTE-p74-m">
                                                        <items>
                                                            <menuItem title="(none)" state="on" id="MTE-p74-i0"/>
                                                            <menuItem title="metal" id="MTE-p74-i1"/>
                                                            <menuItem title="stone" id="MTE-p74-i2"/>
                                                            <menuItem title="flesh" id="MTE-p74-i3"/>
                                                            <menuItem title="wood" id="MTE-p74-i4"/>
                                                            <menuItem title="cardboard" id="MTE-p74-i5"/>
                                                            <menuItem title="liquid" id="MTE-p74-i6"/>
                                                            <menuItem title="glass" id="MTE-p74-i7"/>
                                                            <menuItem title="plastic" id="MTE-p74-i8"/>
                                                            <menuItem title="ricochet" id="MTE-p74-i9"/>
                                                            <menuItem title="surftype10" id="MTE-p74-i10"/>
                                                            <menuItem title="surftype11" id="MTE-p74-i11"/>
                                                            <menuItem title="surftype12" id="MTE-p74-i12"/>
                                                            <menuItem title="surftype13" id="MTE-p74-i13"/>
                                                            <menuItem title="surftype14" id="MTE-p74-i14"/>
                                                            <menuItem title="surftype15" id="MTE-p74-i15"/>
                                                        </items>
                                                    </menu>
                                                </popUpButtonCell>
                                                <connections>
                                                    <binding destination="MTE-oc" name="selectedValue" keyPath="selection.surfaceType" id="MTE-p74-b"/>
                                                </connections>
                                            </popUpButton>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-l77">
                                                <rect key="frame" x="4" y="731" width="88" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Clamp:" id="MTE-l77-c">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <popUpButton toolTip="How an image repeats past its edges: clamp (its edge pixels stretch), zeroclamp (black), alphazeroclamp (transparent); none repeats it." verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-p76">
                                                <rect key="frame" x="96" y="725" width="160" height="25"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                                <popUpButtonCell key="cell" type="push" title="(none)" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="MTE-p76-i0" id="MTE-p76-c">
                                                    <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="message"/>
                                                    <menu key="menu" id="MTE-p76-m">
                                                        <items>
                                                            <menuItem title="(none)" state="on" id="MTE-p76-i0"/>
                                                            <menuItem title="clamp" id="MTE-p76-i1"/>
                                                            <menuItem title="zeroclamp" id="MTE-p76-i2"/>
                                                            <menuItem title="alphazeroclamp" id="MTE-p76-i3"/>
                                                        </items>
                                                    </menu>
                                                </popUpButtonCell>
                                                <connections>
                                                    <binding destination="MTE-oc" name="selectedValue" keyPath="selection.clampMode" id="MTE-p76-b"/>
                                                </connections>
                                            </popUpButton>
                                            <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-l79">
                                                <rect key="frame" x="4" y="704" width="88" height="16"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
