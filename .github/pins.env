# What UDQuakeTools builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux, Windows  each one's archive, unpacked into the GNUstep prefix, the stack first
#   Apple  Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.27
# Core Data on GNUstep: the framework, momc, coredata-model.make
# (ashalkhakov/FreeCoreData).
FREECOREDATA_VERSION=0.11.0
# Quarry's text editor, its tab bar, and the grammars it highlights
# with (idScript): the frameworks and grammar bundles (ashalkhakov/UDCodeKit).
UDCODEKIT_VERSION=0.8.2
# The Mac apps' updates.
SPARKLE_VERSION=2.10.0
