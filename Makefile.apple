# UDQuakeTools on macOS, the familiar way (gnustep-release-actions' macos.yml
# runs the same):
#
#   make -f Makefile.apple            UDLauncher.app, universal (Release)
#   make -f Makefile.apple check      its Debug build
#   make -f Makefile.apple install DESTDIR=<dir>       UDLauncher.app
#   make -f Makefile.apple installcheck DESTDIR=<dir>  its signature holds, and
#                                     it starts and stays up, in a fresh home
#
# UDLauncher alone for now: UDCore, Decl Browser and the tests link libzip,
# which has no universal build to ship on the Mac yet (on GNUstep it is
# Ubuntu's libzip-dev, and all of them build and are tested there:
# GNUmakefile). Sparkle's XCFramework is in .deps/, by the version
# .github/pins.env names (gnustep-release-actions' scripts/deps.sh apple).

BUILD = build
DERIVED = $(BUILD)/DerivedData
RELEASE = $(DERIVED)/Build/Products/Release
XCODEBUILD = xcodebuild -project PakManager.xcodeproj -derivedDataPath $(DERIVED)

all:
	@test -d .deps/Sparkle.xcframework \
	  || { echo "no Sparkle in .deps: gnustep-release-actions' scripts/deps.sh apple fetches what .github/pins.env names"; exit 1; }
	$(XCODEBUILD) -scheme UDLauncher -configuration Release -destination 'generic/platform=macOS' build

check:
	$(XCODEBUILD) -scheme UDLauncher -configuration Debug -destination 'platform=macOS' build

install: all
	@test -n "$(DESTDIR)" || { echo "install: give DESTDIR"; exit 1; }
	mkdir -p $(DESTDIR)
	rm -rf $(DESTDIR)/UDLauncher.app
	ditto $(RELEASE)/UDLauncher.app $(DESTDIR)/UDLauncher.app

installcheck:
	codesign --verify --deep --strict $(DESTDIR)/UDLauncher.app
	@home=$$(mktemp -d); log=$$(mktemp); \
	  HOME=$$home CFFIXED_USER_HOME=$$home $(DESTDIR)/UDLauncher.app/Contents/MacOS/UDLauncher > $$log 2>&1 & pid=$$!; \
	  sleep 10; \
	  if kill -0 $$pid 2>/dev/null; then kill $$pid; echo "UDLauncher: up after 10s"; \
	  else cat $$log; echo "UDLauncher exited on its own"; exit 1; fi

clean:
	rm -rf $(BUILD)

.PHONY: all check install installcheck clean
