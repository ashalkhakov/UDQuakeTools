# What UDQuakeTools builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux, Windows  each one's archive, unpacked into the GNUstep prefix, the stack first

# The patched GNUstep stack (ashalkhakov/gnustep-patches), with its Core Data
# (FreeCoreData: the framework, momc, coredata-model.make).
GNUSTEP_PATCHES_VERSION=2026.10.20.46
# UDCode's SDK (ashalkhakov/UDCodeKit's udcodekit archives): what the
# extension builds on, its engines.udcode (UDCodeExtension/package.json).
UDCODEKIT_VERSION=0.22.1
# What UDCode's SDK links on Windows, and so its closure needs: the
# DiagramKit that UDCode release carries (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
