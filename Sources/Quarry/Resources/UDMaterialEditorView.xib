<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDMaterialEditorViewController">
            <connections>
                <outlet property="view" destination="MTE-root" id="UDM-o-view"/>
                <outlet property="objectController" destination="MTE-oc" id="UDM-o-objectController"/>
                <outlet property="stagesController" destination="MTE-sac" id="UDM-o-stagesController"/>
                <outlet property="stagesTable" destination="MTE-stages" id="UDM-o-stagesTable"/>
                <outlet property="previewView" destination="MTE-preview" id="UDM-o-previewView"/>
                <outlet property="previewLabel" destination="MTE-previewlabel" id="UDM-o-previewLabel"/>
                <outlet property="materialPreviewView" destination="MTE-matpreview" id="UDM-o-materialPreviewView"/>
                <outlet property="lightingLabel" destination="MTE-lighting" id="UDM-o-lightingLabel"/>
                <outlet property="transportView" destination="MTE-transport" id="UDM-o-transportView"/>
                <outlet property="inspectorView" destination="MTE-inspector" id="UDM-o-inspectorView"/>
                <outlet property="inspectorTabs" destination="MTE-itabs" id="UDM-o-inspectorTabs"/>
                <outlet property="materialScroll" destination="MTE-mscroll" id="UDM-o-materialScroll"/>
                <outlet property="stageScroll" destination="MTE-sscroll" id="UDM-o-stageScroll"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <objectController objectClassName="UDDeclMaterial" id="MTE-oc" userLabel="Object Controller">
            <classReference key="objectClass" className="UDDeclMaterial"/>
        </objectController>
        <arrayController avoidsEmptySelection="NO" objectClassName="UDMaterialStage" id="MTE-sac" userLabel="UDMaterialStage Array Controller">
            <classReference key="objectClass" className="UDMaterialStage"/>
            <connections>
                <binding destination="MTE-oc" name="contentArray" keyPath="selection.stages" id="MTE-sac-b"/>
            </connections>
        </arrayController>
        <customView id="MTE-root">
            <rect key="frame" x="0.0" y="0.0" width="900" height="640"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <imageView toolTip="material preview" horizontalHuggingPriority="251" verticalHuggingPriority="251" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-matpreview">
                    <rect key="frame" x="20" y="300" width="320" height="320"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyUpOrDown" imageFrameStyle="grayBezel" id="MTE-matpreview-c"/>
                </imageView>
                <customView toolTip="time controls" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-transport">
                    <rect key="frame" x="20" y="240" width="320" height="56"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                </customView>
                <textField toolTip="lighting problem" focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-lighting">
                    <rect key="frame" x="360" y="540" width="520" height="80"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="charWrapping" title="" id="MTE-lighting-c">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <scrollView fixedFrame="YES" horizontalLineScroll="24" horizontalPageScroll="10" verticalLineScroll="24" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-stages-s">
                    <rect key="frame" x="20" y="37" width="860" height="197"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" id="MTE-stages-cv">
                        <rect key="frame" x="1" y="1" width="858" height="195"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" emptySelection="YES" autosaveColumns="NO" rowHeight="22" headerView="MTE-stages-h" id="MTE-stages">
