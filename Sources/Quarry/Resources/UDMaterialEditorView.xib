                    <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="MTE-stages-vs">
                        <rect key="frame" x="844" y="17" width="15" height="102"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <tableHeaderView key="headerView" wantsLayer="YES" id="MTE-stages-h">
                        <rect key="frame" x="0.0" y="0.0" width="858" height="28"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </tableHeaderView>
                </scrollView>
                <segmentedControl verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-stages-pm">
                    <rect key="frame" x="20" y="12" width="69" height="23"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="smallSquare" trackingMode="selectOne" id="MTE-stages-pm-c">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="+" width="32"/>
                            <segment label="-" width="32" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="addOrRemoveStage:" target="-2" id="MTE-stages-pm-a"/>
                    </connections>
                </segmentedControl>
                <segmentedControl toolTip="move stage" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-move">
                    <rect key="frame" x="95" y="12" width="69" height="23"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="smallSquare" trackingMode="momentary" id="MTE-move-c">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="↑" width="32"/>
                            <segment label="↓" width="32" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="moveStage:" target="-2" id="MTE-move-a"/>
                    </connections>
                </segmentedControl>
                <popUpButton toolTip="add lighting stage" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="MTE-addlit">
                    <rect key="frame" x="170" y="10" width="120" height="25"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Add Map" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" pullsDown="YES" id="MTE-addlit-c">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="message"/>
                        <menu key="menu" id="MTE-addlit-m">
                            <items>
                                <menuItem title="Add Map" hidden="YES" id="MTE-addlit-i0"/>
                                <menuItem title="Bump Map" tag="1" id="MTE-addlit-i1">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a1"/></connections>
                                </menuItem>
                                <menuItem title="Diffuse Map" tag="2" id="MTE-addlit-i2">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a2"/></connections>
                                </menuItem>
                                <menuItem title="Specular Map" tag="3" id="MTE-addlit-i3">
                                    <connections><action selector="addLightingStage:" target="-2" id="MTE-addlit-a3"/></connections>
                                </menuItem>
                            </items>
                        </menu>
                    </popUpButtonCell>
                </popUpButton>

            </subviews>
        </customView>
