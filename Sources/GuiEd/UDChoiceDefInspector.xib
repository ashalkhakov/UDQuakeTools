<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDChoiceDefInspectorController">
            <connections>
                <outlet property="view" destination="V-ATTR-CHOICE" id="OWN-VIEW"/>
                <outlet property="attrChoiceChoiceTypeField" destination="FLD-ATTR-CHOICETYPE" id="OWN-76"/>
                <outlet property="attrChoiceChoicesField" destination="FLD-ATTR-CHOICES" id="OWN-25"/>
                <outlet property="attrChoiceCurrentField" destination="FLD-ATTR-CHOICECUR" id="OWN-27"/>
                <outlet property="attrChoiceCvarField" destination="FLD-ATTR-CHOICECVAR" id="OWN-24"/>
                <outlet property="attrChoiceCvarGroupField" destination="FLD-ATTR-CHOICECVARGROUP" id="OWN-77"/>
                <outlet property="attrChoiceGuiField" destination="FLD-ATTR-CHOICEGUI" id="OWN-78"/>
                <outlet property="attrChoiceLiveUpdateButton" destination="CHK-ATTR-CHOICELIVEUPDATE" id="OWN-79"/>
                <outlet property="attrChoiceValuesField" destination="FLD-ATTR-VALUES" id="OWN-26"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <view key="view" id="V-ATTR-CHOICE">
                                                    <rect key="frame" x="0.0" y="0.0" width="668" height="168"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-ATTR-CHOICEDEF">
                                                            <rect key="frame" x="0.0" y="146" width="180" height="16"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="choiceDef" id="LBL-ATTR-CHOICEDEF-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                        </textField>
                                                        <textField toolTip="The cvar to attach to. It displays the value of the cvar, and changes the cvar when the user changes the text." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICECVAR">
                                                            <rect key="frame" x="0.0" y="120" width="150" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="cvar" id="FLD-ATTR-CHOICECVAR-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICECVAR"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="Semicolon separated list of choices (Yes;No)." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICES">
                                                            <rect key="frame" x="156" y="120" width="176" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="choices" id="FLD-ATTR-CHOICES-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICES"/>
                                                            </connections>
                                                        </textField>
                                                        <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-VALUES">
                                                            <rect key="frame" x="338" y="120" width="176" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <string key="toolTip">Semicolon separated list of values. It should have the same number of items as 'choices'. Defaults to the choices list when left empty.</string>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="values" id="FLD-ATTR-VALUES-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-VALUES"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="The currently selected choice." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICECUR">
                                                            <rect key="frame" x="520" y="120" width="84" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="current" id="FLD-ATTR-CHOICECUR-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICECUR"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="0 means the cvar contains a 0-based index. 1 means the cvar contains a value string." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICETYPE">
                                                            <rect key="frame" x="0.0" y="92" width="80" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="choicetype" id="FLD-ATTR-CHOICETYPE-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICETYPE"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="GUI parm to attach to. It will contain the current choice as a numeric value." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICEGUI">
                                                            <rect key="frame" x="88" y="92" width="220" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="gui" id="FLD-ATTR-CHOICEGUI-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICEGUI"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="Cvar group this item belongs to. This allows grouped cvar read/write commands such as 'cvar read audio'." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-CHOICECVARGROUP">
                                                            <rect key="frame" x="316" y="92" width="180" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="cvarGroup" id="FLD-ATTR-CHOICECVARGROUP-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICECVARGROUP"/>
                                                            </connections>
                                                        </textField>
                                                        <button id="CHK-ATTR-CHOICELIVEUPDATE">
                                                            <rect key="frame" x="504" y="94" width="112" height="18"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <string key="toolTip">If enabled, the cvar updates as the text changes and the text updates as the cvar changes. Otherwise it only changes on explicit cvar read/write commands. Default: true.</string>
                                                            <buttonCell key="cell" type="check" title="Live Update" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="CHK-ATTR-CHOICELIVEUPDATE-CELL">
                                                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                                <font key="font" metaFont="system"/>
                                                            </buttonCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-CHOICELIVEUPDATE"/>
                                                            </connections>
                                                        </button>
                                                    </subviews>
                                                </view>
    </objects>
</document>
