                                            </textField>
                                            <textField toolTip="Force a specific draw surface width. Use on the desktop window." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-INFO-FORCEASPECTWIDTH">
