        <customView id="PNL-IDENTITY">
            <rect key="frame" x="0.0" y="0.0" width="668" height="632"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-CLASS">
                    <rect key="frame" x="0.0" y="610" width="80" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="Class" id="LBL-CLASS-CELL"/>
                </textField>
                <popUpButton verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-CLASS">
                    <rect key="frame" x="0.0" y="120" width="300" height="24"/>
                    <autoresizingMask key="autoresizingMask"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="FLD-CLASS-CELL">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" title="Class" id="FLD-CLASS-MENU">
                            <items>
                                <menuItem title="listDef" id="ITM-CLASS-LIST"/>
                                <menuItem title="renderDef" id="ITM-CLASS-RENDER"/>
                                <menuItem title="sliderDef" id="ITM-CLASS-SLIDER"/>
                                <menuItem title="bindDef" id="ITM-CLASS-BIND"/>
                                <menuItem title="choiceDef" id="ITM-CLASS-CHOICE"/>
                                <menuItem title="editDef" id="ITM-CLASS-EDIT"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="commitWindowIdentityEdit:" target="-2" id="ACT-CLASS"/>
                    </connections>
                </popUpButton>
                <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-NAME">
                    <rect key="frame" x="316" y="610" width="80" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="Name" id="LBL-NAME-CELL"/>
                </textField>
                <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-NAME">
                    <rect key="frame" x="316" y="120" width="300" height="24"/>
