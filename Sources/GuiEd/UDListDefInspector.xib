<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDListDefInspectorController">
            <connections>
                <outlet property="view" destination="V-ATTR-LIST" id="OWN-VIEW"/>
                <outlet property="attrListHorizontalButton" destination="CHK-ATTR-LIST-HORIZONTAL" id="OWN-60"/>
                <outlet property="attrListMultipleSelButton" destination="CHK-ATTR-LIST-MULTI" id="OWN-61"/>
                <outlet property="attrListNameField" destination="FLD-ATTR-LIST-NAME" id="OWN-62"/>
                <outlet property="attrListTabAlignsField" destination="FLD-ATTR-LIST-TABALIGNS" id="OWN-63"/>
                <outlet property="attrListTabAlignsHintLabel" destination="LBL-ATTR-LIST-TABALIGNS-HINT" id="OWN-67"/>
                <outlet property="attrListTabStopsField" destination="FLD-ATTR-LIST-TABSTOPS" id="OWN-64"/>
                <outlet property="attrListTabStopsHintLabel" destination="LBL-ATTR-LIST-TABSTOPS-HINT" id="OWN-66"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <view key="view" id="V-ATTR-LIST">
                                                    <rect key="frame" x="0.0" y="0.0" width="668" height="168"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-ATTR-LISTDEF">
                                                            <rect key="frame" x="0.0" y="146" width="120" height="16"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="listDef" id="LBL-ATTR-LISTDEF-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                        </textField>
                                                        <button toolTip="This list goes left-to-right (untested)." id="CHK-ATTR-LIST-HORIZONTAL">
                                                            <rect key="frame" x="0.0" y="122" width="96" height="18"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <buttonCell key="cell" type="check" title="Horizontal" bezelStyle="regularSquare" imagePosition="left" inset="2" id="CHK-ATTR-LIST-HORIZONTAL-CELL">
                                                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                                <font key="font" metaFont="system"/>
                                                            </buttonCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-LIST-HORIZONTAL"/>
                                                            </connections>
                                                        </button>
                                                        <textField toolTip="The name of the list. The code uses this to populate the list with items." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-LIST-NAME">
                                                            <rect key="frame" x="96" y="120" width="126" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="listName" id="FLD-ATTR-LIST-NAME-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-LIST-NAME"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="Comma separated list of pixel offsets for a multi-column list." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-LIST-TABSTOPS">
                                                            <rect key="frame" x="228" y="120" width="120" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="tabStops" id="FLD-ATTR-LIST-TABSTOPS-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-LIST-TABSTOPS"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="tabstops must be comma-separated integers" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-ATTR-LIST-TABSTOPS-HINT">
                                                            <rect key="frame" x="228" y="104" width="120" height="14"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="ints" id="LBL-ATTR-LIST-TABSTOPS-HINT-CELL">
                                                                <font key="font" metaFont="miniSystem"/>
                                                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                        </textField>
                                                        <textField toolTip="Comma separated list of textalign values for each column." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" textCompletion="NO" translatesAutoresizingMaskIntoConstraints="NO" id="FLD-ATTR-LIST-TABALIGNS">
                                                            <rect key="frame" x="354" y="120" width="118" height="22"/>
                                                            <autoresizingMask key="autoresizingMask"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" placeholderString="tabAligns" id="FLD-ATTR-LIST-TABALIGNS-CELL">
                                                                <font key="font" metaFont="system"/>
                                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-LIST-TABALIGNS"/>
                                                            </connections>
                                                        </textField>
                                                        <textField toolTip="tabaligns must be 0,1,2 values" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-ATTR-LIST-TABALIGNS-HINT">
                                                            <rect key="frame" x="354" y="104" width="118" height="14"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="0,1,2" id="LBL-ATTR-LIST-TABALIGNS-HINT-CELL">
                                                                <font key="font" metaFont="miniSystem"/>
                                                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                            </textFieldCell>
                                                        </textField>
                                                        <button toolTip="Multiple items can be selected. This requires code support." id="CHK-ATTR-LIST-MULTI">
                                                            <rect key="frame" x="0.0" y="94" width="112" height="18"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            <buttonCell key="cell" type="check" title="Multiple Sel" bezelStyle="regularSquare" imagePosition="left" inset="2" id="CHK-ATTR-LIST-MULTI-CELL">
                                                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                                <font key="font" metaFont="system"/>
                                                            </buttonCell>
                                                            <connections>
                                                                <action selector="commitTypedAttributesPanel:" target="-2" id="ACT-ATTR-LIST-MULTI"/>
                                                            </connections>
                                                        </button>
                                                    </subviews>
                                                </view>
    </objects>
</document>
