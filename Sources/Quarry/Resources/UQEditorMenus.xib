<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UQCommands">
            <connections>
                <outlet property="menu" destination="UQM-menu" id="UQM-o-menu"/>
                <outlet property="folderMenu" destination="UQM-new-menu" id="UQM-o-new-menu"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="Quarry" id="UQM-menu" userLabel="Editor Menu Items">
            <items>
                <menuItem title="New Declaration…" id="UQM-newdecl">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="newDecl:" target="-2" id="UQM-newdecl-a"/>
                    </connections>
                </menuItem>
                <menuItem title="New PDA…" id="UQM-newpda">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="newPDA:" target="-2" id="UQM-newpda-a"/>
                    </connections>
                </menuItem>
                <menuItem title="New Skin…" id="UQM-newskin">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="newSkin:" target="-2" id="UQM-newskin-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Find in Decls…" id="UQM-find">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="findInDecls:" target="-2" id="UQM-find-a"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="UQM-sep1"/>
                <menuItem title="Test Declaration" id="UQM-test">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="testDecl:" target="-2" id="UQM-test-a"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="UQM-sep2"/>
                <menuItem title="Workspace Settings…" id="UQM-settings">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showWorkspaceSettings:" target="-2" id="UQM-settings-a"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="UQM-sep3"/>
                <menuItem title="Zoom In" id="UQM-zin">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="zoomIn:" target="-1" id="UQM-zin-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Zoom Out" id="UQM-zout">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="zoomOut:" target="-1" id="UQM-zout-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Zoom to Fit" id="UQM-zfit">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="zoomToFit:" target="-1" id="UQM-zfit-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Show Grid" id="UQM-grid">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="toggleGrid:" target="-1" id="UQM-grid-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Snap to Grid" id="UQM-snap">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="toggleGridSnap:" target="-1" id="UQM-snap-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Show Status Bar" id="UQM-status">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="toggleStatusBar:" target="-1" id="UQM-status-a"/>
                    </connections>
                </menuItem>
                <menuItem title="GUI Editor Options…" id="UQM-opts">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showGuiEditorOptions:" target="-1" id="UQM-opts-a"/>
                    </connections>
                </menuItem>
            </items>
        </menu>
        <menu title="Quarry" id="UQM-new-menu" userLabel="A Folder's Editor Menu Items">
            <items>
                <menuItem title="New Quarry Workspace…" id="UQM-newws">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="newWorkspace:" target="-2" id="UQM-newws-a"/>
                    </connections>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
