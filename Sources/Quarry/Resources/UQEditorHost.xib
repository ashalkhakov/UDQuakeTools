<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UQEditorHost">
            <connections>
                <outlet property="view" destination="EH-root" id="EH-o-view"/>
                <outlet property="splitView" destination="EH-split" id="EH-o-split"/>
                <outlet property="navigatorTabs" destination="EH-tabs" id="EH-o-tabs"/>
                <outlet property="editorHost" destination="EH-editor" id="EH-o-editor"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="EH-root" userLabel="Editor Host">
            <rect key="frame" x="0.0" y="0.0" width="800" height="560"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <splitView dividerStyle="thin" vertical="YES" id="EH-split" userLabel="Navigator | Editor">
                    <rect key="frame" x="0.0" y="0.0" width="800" height="560"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <tabView type="noTabsNoBorder" id="EH-tabs" userLabel="Navigator Panes">
                            <rect key="frame" x="0.0" y="0.0" width="220" height="560"/>
                            <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                            <font key="font" metaFont="system"/>
                        </tabView>
                        <customView id="EH-editor" userLabel="Editor">
                            <rect key="frame" x="221" y="0.0" width="579" height="560"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </customView>
                    </subviews>
                    <holdingPriorities>
                        <real value="260"/>
                        <real value="250"/>
                    </holdingPriorities>
                </splitView>
            </subviews>
        </customView>
    </objects>
</document>
