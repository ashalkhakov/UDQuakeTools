<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="DB-APP-DEL" id="DB-APP-DEL-CONN"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="DB-FONT-MGR" customClass="NSFontManager"/>
        <customObject id="DB-APP-DEL" customClass="UDDeclBrowserAppDelegate"/>
        <menu title="Main Menu" systemMenu="main" id="DB-MENU-MAIN">
            <items>
                <menuItem title="Decl Browser" id="DB-MENU-APP-ROOT">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Decl Browser" systemMenu="apple" id="DB-MENU-APP">
                        <items>
                            <menuItem title="About Decl Browser" id="DB-MENU-APP-ABOUT">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-1" id="DB-MENU-APP-ABOUT-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="DB-MENU-APP-SEP-1"/>
                            <menuItem title="Services" id="DB-MENU-APP-SVC">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Services" systemMenu="services" id="DB-MENU-SERVICES"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="DB-MENU-APP-SEP-2"/>
                            <menuItem title="Hide Decl Browser" keyEquivalent="h" id="DB-MENU-APP-HIDE">
                                <connections>
                                    <action selector="hide:" target="-1" id="DB-MENU-APP-HIDE-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="DB-MENU-APP-HIDE-OTHERS">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="DB-MENU-APP-HIDE-OTHERS-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="DB-MENU-APP-SHOW-ALL">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="DB-MENU-APP-SHOW-ALL-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="DB-MENU-APP-SEP-3"/>
                            <menuItem title="Quit Decl Browser" keyEquivalent="q" id="DB-MENU-APP-QUIT">
                                <connections>
                                    <action selector="terminate:" target="-1" id="DB-MENU-APP-QUIT-ACT"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="DB-MENU-FILE-ROOT">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="File" id="DB-MENU-FILE">
                        <items>
                            <menuItem title="Close" keyEquivalent="w" id="DB-MENU-FILE-CLOSE">
                                <connections>
                                    <action selector="performClose:" target="-1" id="DB-MENU-FILE-CLOSE-ACT"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="DB-MENU-WINDOW-ROOT">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="DB-MENU-WINDOW">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="DB-MENU-WINDOW-MIN">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="DB-MENU-WINDOW-MIN-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Zoom" id="DB-MENU-WINDOW-ZOOM">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="performZoom:" target="-1" id="DB-MENU-WINDOW-ZOOM-ACT"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="DB-MENU-WINDOW-SEP"/>
                            <menuItem title="Bring All to Front" id="DB-MENU-WINDOW-FRONT">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="DB-MENU-WINDOW-FRONT-ACT"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
