<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="UDL-delegate-01" id="UDL-outlet-01"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="UDL-delegate-01" customClass="UDLauncherAppDelegate"/>
        <menu title="Main Menu" systemMenu="main" id="UDL-menu-main">
            <items>
                <menuItem title="UDQuakeTools" id="UDL-menu-app-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="UDQuakeTools" systemMenu="apple" id="UDL-menu-apple">
                        <items>
                            <menuItem title="About UDQuakeTools" id="UDL-menu-about">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-1" id="UDL-act-about"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="UDL-sep-1"/>
                            <menuItem title="Services" id="UDL-menu-services">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Services" systemMenu="services" id="UDL-menu-services-sub"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="UDL-sep-2"/>
                            <menuItem title="Hide UDQuakeTools" keyEquivalent="h" id="UDL-menu-hide">
                                <connections>
                                    <action selector="hide:" target="-1" id="UDL-act-hide"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="UDL-menu-hide-others">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="UDL-act-hide-others"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="UDL-menu-show-all">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="UDL-act-show-all"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="UDL-sep-3"/>
                            <menuItem title="Quit UDQuakeTools" keyEquivalent="q" id="UDL-menu-quit">
                                <connections>
                                    <action selector="terminate:" target="-1" id="UDL-act-quit"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="UDL-menu-window-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="UDL-menu-window">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="UDL-menu-minimize">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="UDL-act-minimize"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Zoom" id="UDL-menu-zoom">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="performZoom:" target="-1" id="UDL-act-zoom"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
