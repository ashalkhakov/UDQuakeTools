<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDSoundEditorViewController">
            <connections>
                <outlet property="view" destination="SDE-root" id="UDS-o-view"/>
                <outlet property="objectController" destination="SDE-oc" id="UDS-o-objectController"/>
                <outlet property="samplesController" destination="SDE-sac" id="UDS-o-samplesController"/>
                <outlet property="leadinsController" destination="SDE-lac" id="UDS-o-leadinsController"/>
                <outlet property="samplesTable" destination="SDE-samples" id="UDS-o-samplesTable"/>
                <outlet property="leadinsTable" destination="SDE-leadins" id="UDS-o-leadinsTable"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <objectController objectClassName="UDDeclSound" id="SDE-oc" userLabel="Object Controller">
            <classReference key="objectClass" className="UDDeclSound"/>
        </objectController>
        <arrayController objectClassName="UDSoundSample" id="SDE-sac" userLabel="UDSoundSample Array Controller">
            <classReference key="objectClass" className="UDSoundSample"/>
            <connections>
                <binding destination="SDE-oc" name="contentArray" keyPath="selection.samples" id="SDE-sac-b"/>
            </connections>
        </arrayController>
        <arrayController objectClassName="UDSoundSample" id="SDE-lac" userLabel="UDSoundSample Array Controller">
            <classReference key="objectClass" className="UDSoundSample"/>
            <connections>
                <binding destination="SDE-oc" name="contentArray" keyPath="selection.leadins" id="SDE-lac-b"/>
            </connections>
        </arrayController>
        <customView id="SDE-root">
