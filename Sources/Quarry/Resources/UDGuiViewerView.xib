<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDGuiEditorViewController">
            <connections>
                <outlet property="viewerView" destination="GUV-root" id="GUV-o-viewer"/>
                <outlet property="guiView" destination="GUV-gui" id="GUV-o-gui"/>
                <outlet property="transportView" destination="GUV-transport" id="GUV-o-transport"/>
                <outlet property="statusField" destination="GUV-status" id="GUV-o-status"/>
                <outlet property="namedEventPopUp" destination="GUV-events" id="GUV-o-events"/>
                <outlet property="modeControl" destination="GUV-mode" id="GUV-o-mode"/>
                <outlet property="stateTable" destination="GUV-state" id="GUV-o-state"/>
                <outlet property="logTable" destination="GUV-log" id="GUV-o-log"/>
                <outlet property="stateView" destination="GUV-tab-state-v" id="GUV-o-stateView"/>
                <outlet property="windowsView" destination="GUV-win-v" id="GUV-o-winView"/>
                <outlet property="windowsOutline" destination="GUV-win" id="GUV-o-winOutline"/>
                <outlet property="propertiesView" destination="GUV-prop-v" id="GUV-o-propView"/>
                <outlet property="propertiesScroll" destination="GUV-prop-scroll" id="GUV-o-propScroll"/>
                <outlet property="propertiesPlaceholder" destination="GUV-prop-none" id="GUV-o-propNone"/>
                <outlet property="scriptsController" destination="GUV-sc" id="GUV-o-scriptsController"/>
                <outlet property="scriptsView" destination="GUV-scr-v" id="GUV-o-scrView"/>
                <outlet property="designMenu" destination="GUV-menu" id="GUV-o-menu"/>
                <outlet property="selectMenu" destination="GUV-menu-select-m" id="GUV-o-selectMenu"/>
                <outlet property="logView" destination="GUV-tab-log-v" id="GUV-o-logView"/>
                <outlet property="itemProperties" destination="GUV-ip" id="GUV-o-GUV-ip"/>
                <outlet property="layoutView" destination="GUV-layout-v" id="GUV-o-GUV-layout-v"/>
                <outlet property="layoutPlaceholder" destination="GUV-lay-none" id="GUV-o-GUV-lay-none"/>
                <outlet property="layoutXField" destination="GUV-lay-x" id="GUV-o-GUV-lay-x"/>
                <outlet property="layoutYField" destination="GUV-lay-y" id="GUV-o-GUV-lay-y"/>
                <outlet property="layoutWField" destination="GUV-lay-w" id="GUV-o-GUV-lay-w"/>
                <outlet property="layoutHField" destination="GUV-lay-h" id="GUV-o-GUV-lay-h"/>
            </connections>
        </customObject>
        <customObject id="GUV-ip" customClass="UDGuiItemPropertiesController">
            <connections>
                <outlet property="nameField" destination="GUV-ip-name" id="GUV-ip-name-o"/>
                <outlet property="typeField" destination="GUV-ip-type" id="GUV-ip-type-o"/>
                <outlet property="visibleButton" destination="GUV-ip-visible" id="GUV-ip-visible-o"/>
                <outlet property="noTimeButton" destination="GUV-ip-notime" id="GUV-ip-notime-o"/>
                <outlet property="noEventsButton" destination="GUV-ip-noevents" id="GUV-ip-noevents-o"/>
                <outlet property="noClipButton" destination="GUV-ip-noclip" id="GUV-ip-noclip-o"/>
                <outlet property="noCursorButton" destination="GUV-ip-nocursor" id="GUV-ip-nocursor-o"/>
                <outlet property="useMaterialButton" destination="GUV-ip-usemat" id="GUV-ip-usemat-o"/>
                <outlet property="backgroundField" destination="GUV-ip-background" id="GUV-ip-background-o"/>
                <outlet property="variableBackgroundButton" destination="GUV-ip-varbg" id="GUV-ip-varbg-o"/>
                <outlet property="matScaleXField" destination="GUV-ip-matscalex" id="GUV-ip-matscalex-o"/>
                <outlet property="matScaleYField" destination="GUV-ip-matscaley" id="GUV-ip-matscaley-o"/>
                <outlet property="xScaleLabel" destination="GUV-ip-l-xscale" id="GUV-ip-l-xscale-o"/>
                <outlet property="yScaleLabel" destination="GUV-ip-l-yscale" id="GUV-ip-l-yscale-o"/>
                <outlet property="useBackColorButton" destination="GUV-ip-usebackcolor" id="GUV-ip-usebackcolor-o"/>
                <outlet property="backColorWell" destination="GUV-ip-backcolor" id="GUV-ip-backcolor-o"/>
                <outlet property="borderSizeField" destination="GUV-ip-bordersize" id="GUV-ip-bordersize-o"/>
                <outlet property="useBorderColorButton" destination="GUV-ip-usebordercolor" id="GUV-ip-usebordercolor-o"/>
                <outlet property="useBorderMaterialButton" destination="GUV-ip-usebordermat" id="GUV-ip-usebordermat-o"/>
                <outlet property="borderColorWell" destination="GUV-ip-bordercolor" id="GUV-ip-bordercolor-o"/>
                <outlet property="borderMaterialField" destination="GUV-ip-bordermat" id="GUV-ip-bordermat-o"/>
                <outlet property="matColorLabel" destination="GUV-ip-l-matcolor" id="GUV-ip-l-matcolor-o"/>
                <outlet property="matColorWell" destination="GUV-ip-matcolor" id="GUV-ip-matcolor-o"/>
                <outlet property="useTextButton" destination="GUV-ip-usetext" id="GUV-ip-usetext-o"/>
                <outlet property="foreColorWell" destination="GUV-ip-forecolor" id="GUV-ip-forecolor-o"/>
                <outlet property="textField" destination="GUV-ip-text" id="GUV-ip-text-o"/>
                <outlet property="textScaleField" destination="GUV-ip-textscale" id="GUV-ip-textscale-o"/>
                <outlet property="textAlignPopUp" destination="GUV-ip-textalign" id="GUV-ip-textalign-o"/>
                <outlet property="textAlignXField" destination="GUV-ip-textalignx" id="GUV-ip-textalignx-o"/>
                <outlet property="textAlignYField" destination="GUV-ip-textaligny" id="GUV-ip-textaligny-o"/>
                <outlet property="fontPopUp" destination="GUV-ip-font" id="GUV-ip-font-o"/>
                <outlet property="noWrapButton" destination="GUV-ip-nowrap" id="GUV-ip-nowrap-o"/>
                <outlet property="colorLabel" destination="GUV-ip-l-color" id="GUV-ip-l-color-o"/>
                <outlet property="scaleLabel" destination="GUV-ip-l-scale" id="GUV-ip-l-scale-o"/>
                <outlet property="alignmentLabel" destination="GUV-ip-l-align" id="GUV-ip-l-align-o"/>
                <outlet property="alignXLabel" destination="GUV-ip-l-alignx" id="GUV-ip-l-alignx-o"/>
                <outlet property="alignYLabel" destination="GUV-ip-l-aligny" id="GUV-ip-l-aligny-o"/>
                <outlet property="fontLabel" destination="GUV-ip-l-font" id="GUV-ip-l-font-o"/>
            </connections>
        </customObject>
        <customObject id="GUV-sc" customClass="UDGuiScriptsController">
            <connections>
                <outlet property="pages" destination="GUV-sc-pages" id="GUV-sc-pages-o"/>
                <outlet property="message" destination="GUV-sc-message" id="GUV-sc-message-o"/>
                <outlet property="eventsTable" destination="GUV-sc-events" id="GUV-sc-events-o"/>
                <outlet property="addEventButton" destination="GUV-sc-addevent" id="GUV-sc-addevent-o"/>
                <outlet property="variablesTable" destination="GUV-sc-variables" id="GUV-sc-variables-o"/>
                <outlet property="eventPopUp" destination="GUV-sc-event" id="GUV-sc-event-o"/>
                <outlet property="eventParameterLabel" destination="GUV-sc-eventparmlabel" id="GUV-sc-eventparmlabel-o"/>
                <outlet property="eventParameterField" destination="GUV-sc-eventparm" id="GUV-sc-eventparm-o"/>
                <outlet property="eventHelp" destination="GUV-sc-eventhelp" id="GUV-sc-eventhelp-o"/>
                <outlet property="statementsOutline" destination="GUV-sc-statements" id="GUV-sc-statements-o"/>
                <outlet property="addStatementButton" destination="GUV-sc-addstatement" id="GUV-sc-addstatement-o"/>
                <outlet property="statementHelp" destination="GUV-sc-statementhelp" id="GUV-sc-statementhelp-o"/>
                <outlet property="conditionLabel" destination="GUV-sc-conditionlabel" id="GUV-sc-conditionlabel-o"/>
                <outlet property="conditionField" destination="GUV-sc-condition" id="GUV-sc-condition-o"/>
                <outlet property="conditionExpression" destination="GUV-sc-conditionexpr" id="GUV-sc-conditionexpr-o"/>
                <outlet property="parameterLabel1" destination="GUV-sc-parmlabel1" id="GUV-sc-parmlabel1-o"/>
                <outlet property="parameterField1" destination="GUV-sc-parm1" id="GUV-sc-parm1-o"/>
                <outlet property="parameterPick1" destination="GUV-sc-parmpick1" id="GUV-sc-parmpick1-o"/>
                <outlet property="parameterLabel2" destination="GUV-sc-parmlabel2" id="GUV-sc-parmlabel2-o"/>
                <outlet property="parameterField2" destination="GUV-sc-parm2" id="GUV-sc-parm2-o"/>
                <outlet property="parameterPick2" destination="GUV-sc-parmpick2" id="GUV-sc-parmpick2-o"/>
                <outlet property="parameterLabel3" destination="GUV-sc-parmlabel3" id="GUV-sc-parmlabel3-o"/>
                <outlet property="parameterField3" destination="GUV-sc-parm3" id="GUV-sc-parm3-o"/>
                <outlet property="parameterPick3" destination="GUV-sc-parmpick3" id="GUV-sc-parmpick3-o"/>
                <outlet property="parameterLabel4" destination="GUV-sc-parmlabel4" id="GUV-sc-parmlabel4-o"/>
                <outlet property="parameterField4" destination="GUV-sc-parm4" id="GUV-sc-parm4-o"/>
                <outlet property="parameterPick4" destination="GUV-sc-parmpick4" id="GUV-sc-parmpick4-o"/>
                <outlet property="parameterLabel5" destination="GUV-sc-parmlabel5" id="GUV-sc-parmlabel5-o"/>
                <outlet property="parameterField5" destination="GUV-sc-parm5" id="GUV-sc-parm5-o"/>
                <outlet property="parameterPick5" destination="GUV-sc-parmpick5" id="GUV-sc-parmpick5-o"/>
                <outlet property="parameterLabel6" destination="GUV-sc-parmlabel6" id="GUV-sc-parmlabel6-o"/>
                <outlet property="parameterField6" destination="GUV-sc-parm6" id="GUV-sc-parm6-o"/>
                <outlet property="parameterPick6" destination="GUV-sc-parmpick6" id="GUV-sc-parmpick6-o"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="GUV-root">
            <rect key="frame" x="0.0" y="0.0" width="920" height="560"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <customView toolTip="time controls" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-transport">
                    <rect key="frame" x="6" y="2" width="908" height="56"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                </customView>
                <popUpButton toolTip="Send the GUI a named event, as the game does" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-events">
                    <rect key="frame" x="146" y="529" width="180" height="25"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Named Event" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" pullsDown="YES" id="GUV-events-c">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="message"/>
                        <menu key="menu" id="GUV-events-m">
                            <items>
                                <menuItem title="Named Event" hidden="YES" id="GUV-events-i0"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                </popUpButton>
                <segmentedControl toolTip="Run the GUI as the game does, or design it" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-mode">
                    <rect key="frame" x="6" y="530" width="130" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="GUV-mode-c">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="Run" width="62" selected="YES"/>
                            <segment label="Design" width="62" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="changeMode:" target="-2" id="GUV-mode-a"/>
                    </connections>
                </segmentedControl>
                <textField toolTip="The triangles drawn, and the zoom" focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-status">
                    <rect key="frame" x="6" y="60" width="908" height="16"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="Tris: 0   Zoom: 100%" id="GUV-status-c">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-gui" customClass="UDGuiView">
                    <rect key="frame" x="0.0" y="78" width="920" height="444"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                </customView>
            </subviews>
        </customView>
        <customView id="GUV-tab-state-v" userLabel="State">
                <rect key="frame" x="0.0" y="0.0" width="260" height="510"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <scrollView fixedFrame="YES" horizontalLineScroll="20" horizontalPageScroll="10" verticalLineScroll="20" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-state-s">
                        <rect key="frame" x="0.0" y="30" width="260" height="480"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" id="GUV-state-cv">
                            <rect key="frame" x="1" y="1" width="258" height="478"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" rowHeight="18" headerView="GUV-state-h" id="GUV-state">
                                    <rect key="frame" x="0.0" y="0.0" width="258" height="450"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                    <tableColumns>
                                        <tableColumn identifier="key" width="110" minWidth="40" maxWidth="1000" id="GUV-state-key">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Key">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="GUV-state-key-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                        <tableColumn identifier="value" editable="YES" width="139" minWidth="40" maxWidth="1000" id="GUV-state-value">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Value">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="GUV-state-value-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                    </tableColumns>
                                    <connections>
                                        <outlet property="dataSource" destination="-2" id="GUV-state-ds"/>
                                        <outlet property="delegate" destination="-2" id="GUV-state-dl"/>
                                    </connections>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="GUV-state-hs">
                            <rect key="frame" x="1" y="463" width="258" height="16"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="GUV-state-vs">
                            <rect key="frame" x="243" y="29" width="16" height="0.0"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <tableHeaderView key="headerView" wantsLayer="YES" id="GUV-state-h">
                            <rect key="frame" x="0.0" y="0.0" width="258" height="28"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </tableHeaderView>
                    </scrollView>
                    <segmentedControl toolTip="Add a state key, or remove the selected one" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-state-pm">
                        <rect key="frame" x="0.0" y="2" width="69" height="23"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <segmentedCell key="cell" borderStyle="border" alignment="left" style="smallSquare" trackingMode="selectOne" id="GUV-state-pm-c">
                            <font key="font" metaFont="system"/>
                            <segments>
                                <segment label="+" width="32"/>
                                <segment label="-" width="32" tag="1"/>
                            </segments>
                        </segmentedCell>
                        <connections>
                            <action selector="addOrRemoveStateKey:" target="-2" id="GUV-state-pm-a"/>
                        </connections>
                    </segmentedControl>
                </subviews>
        </customView>
        <customView id="GUV-tab-log-v" userLabel="Log">
                <rect key="frame" x="0.0" y="0.0" width="260" height="510"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <scrollView fixedFrame="YES" horizontalLineScroll="18" horizontalPageScroll="10" verticalLineScroll="18" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-log-s">
                        <rect key="frame" x="0.0" y="30" width="260" height="480"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" id="GUV-log-cv">
                            <rect key="frame" x="1" y="1" width="258" height="478"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" rowHeight="16" headerView="GUV-log-h" id="GUV-log">
                                    <rect key="frame" x="0.0" y="0.0" width="258" height="450"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                    <tableColumns>
                                        <tableColumn identifier="line" editable="NO" width="252" minWidth="40" maxWidth="4000" id="GUV-log-line">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="What the GUI asked of the game">
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" title="Text Cell" id="GUV-log-line-c">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                    </tableColumns>
                                    <connections>
                                        <outlet property="dataSource" destination="-2" id="GUV-log-ds"/>
                                        <outlet property="delegate" destination="-2" id="GUV-log-dl"/>
                                    </connections>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="GUV-log-hs">
                            <rect key="frame" x="1" y="463" width="258" height="16"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="GUV-log-vs">
                            <rect key="frame" x="243" y="29" width="16" height="0.0"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <tableHeaderView key="headerView" wantsLayer="YES" id="GUV-log-h">
                            <rect key="frame" x="0.0" y="0.0" width="258" height="28"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </tableHeaderView>
                    </scrollView>
                    <button toolTip="Empty the log" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-log-clear">
                        <rect key="frame" x="-6" y="-5" width="74" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <buttonCell key="cell" type="push" title="Clear" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="GUV-log-clear-c">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="clearLog:" target="-2" id="GUV-log-clear-a"/>
                        </connections>
                    </button>
                </subviews>
        </customView>
        <customView id="GUV-win-v" userLabel="Windows">
            <rect key="frame" x="0.0" y="0.0" width="240" height="510"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <scrollView fixedFrame="YES" horizontalLineScroll="20" horizontalPageScroll="10" verticalLineScroll="20" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="GUV-win-s">
                    <rect key="frame" x="0.0" y="0.0" width="240" height="510"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" id="GUV-win-cv">
                        <rect key="frame" x="1" y="1" width="238" height="508"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <outlineView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="YES" autosaveColumns="NO" rowHeight="18" indentationPerLevel="12" outlineTableColumn="GUV-win-name" id="GUV-win">
